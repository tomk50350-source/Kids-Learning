# Server-side only. Never use a VITE_ prefix or put a key in browser code.
# Keep real .env files out of git, archives, images, and public deployments.
OPENAI_API_KEY=

# Both switches are intentionally off. Only adult tests with fictitious data
# are supported. Neither a parent checkbox nor a CHILD flag enables child use.
OPENAI_REALTIME_ENABLED=false
ADULT_TEST_MODE=false

# OpenAI Realtime GA, NOT the separate GPT-Live-1 API.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
LOCAL_PORT=8787

# Only enable inside a container published as 127.0.0.1:8787:8787.
# The regular Node process must keep this false. Never publish a wildcard port.
LOCAL_CONTAINER_MODE=false
